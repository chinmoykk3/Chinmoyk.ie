# Site URL Configuration (Used for OpenGraph, Twitter cards & Sitemap resolution)
NEXT_PUBLIC_SITE_URL=https://chinmoyk-ie.vercel.app

# Contact Form Email Dispatcher (Optional / Recommended for live form dispatch)
# Provider: Resend (https://resend.com) or SendGrid / Postmark
# Used by: app/api/contact/route.ts
RESEND_API_KEY=re_your_api_key_here
CONTACT_RECIPIENT_EMAIL=chinmoykk3@gmail.com

# Privacy-Friendly Analytics (Optional)
# If provided, enables lightweight cookieless telemetry (Plausible / Cloudflare / Beam)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=chinmoyk.ie
# NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=your_cf_beacon_token
